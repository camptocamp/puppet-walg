[Unit]
Description=Wal-g prometheus exporter

[Service]
Restart=always
User=postgres
Group=postgres
EnvironmentFile=<%= $walg_env_file %>
ExecStart=<%= $install_root %>/wal-g-prometheus-exporter --debug <%= $datadir %>/pg_wal/archive_status/
ExecReload=/bin/kill -HUP $MAINPID

[Install]
WantedBy=multi-user.target
