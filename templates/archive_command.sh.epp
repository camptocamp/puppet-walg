#!/bin/bash

source $1

export AWS_ACCESS_KEY_ID
export AWS_SECRET_ACCESS_KEY
export WALE_S3_PREFIX
export AWS_ENDPOINT
export AWS_S3_FORCE_PATH_STYLE
export AWS_REGION
export WALG_PGP_KEY_PATH
export WALG_GPG_KEY_ID
export S3_USE_LIST_OBJECTS_V1

<% if $pause_archive_on_disk_pressure { -%>
if [ -f <%= $pause_archive_on_disk_pressure_alert_file %> ]; then
  exit 0
else
  exec <%= $bin_path %>/wal-g wal-push $2
fi
<% } else { -%>
exec <%= $bin_path %>/wal-g wal-push $2
<% } -%>
